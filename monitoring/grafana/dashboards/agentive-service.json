{
  "uid": "agentive-service-overview",
  "title": "Agentive Service",
  "description": "HTTP, RAG retrieval, and Gemini generation metrics for the Agentive Service (car-rental RAG pipeline).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["agentive-service", "rag", "gemini"],
  "panels": [
    { "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "id": 100, "collapsed": false, "panels": [] },

    {
      "id": 1, "type": "stat", "title": "Total API Requests",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(http_requests_total)", "legendFormat": "requests", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2, "type": "stat", "title": "RAG Requests",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rag_requests_total)", "legendFormat": "rag requests", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3, "type": "stat", "title": "Gemini Calls",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(gemini_generation_requests_total)", "legendFormat": "gemini calls", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4, "type": "stat", "title": "Fallback Responses",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rag_fallback_total)", "legendFormat": "fallback", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },

    {
      "id": 5, "type": "stat", "title": "Gemini Success",
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(gemini_generation_success_total)", "legendFormat": "success", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6, "type": "stat", "title": "Gemini Failures",
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(gemini_generation_failure_total)", "legendFormat": "failures", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7, "type": "stat", "title": "Gemini 429 / Quota",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(gemini_generation_429_total)", "legendFormat": "429", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },

    { "type": "row", "title": "Rates", "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 }, "id": 101, "collapsed": false, "panels": [] },

    {
      "id": 10, "type": "timeseries", "title": "Gemini Success Rate",
      "description": "rate(gemini_generation_success_total[5m])",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gemini_generation_success_total[5m]))", "legendFormat": "success/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 11, "type": "timeseries", "title": "Gemini Failure Rate",
      "description": "rate(gemini_generation_failure_total[5m])",
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gemini_generation_failure_total[5m]))", "legendFormat": "failure/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 12, "type": "timeseries", "title": "Fallback Rate",
      "description": "rate(rag_fallback_total[5m])",
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(rag_fallback_total[5m]))", "legendFormat": "fallback/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "orange" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },

    { "type": "row", "title": "Latency (p95)", "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 }, "id": 102, "collapsed": false, "panels": [] },

    {
      "id": 20, "type": "timeseries", "title": "HTTP Request Latency (p95)",
      "description": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
      "gridPos": { "x": 0, "y": 19, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 21, "type": "timeseries", "title": "Qdrant Retrieval Latency (p95)",
      "description": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))",
      "gridPos": { "x": 8, "y": 19, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 22, "type": "timeseries", "title": "Gemini Generation Latency (p95)",
      "description": "histogram_quantile(0.95, sum(rate(gemini_generation_duration_seconds_bucket[5m])) by (le))",
      "gridPos": { "x": 16, "y": 19, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(gemini_generation_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },

    { "type": "row", "title": "Errors", "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 }, "id": 103, "collapsed": false, "panels": [] },

    {
      "id": 30, "type": "timeseries", "title": "Gemini Quota / 429 Failures",
      "description": "rate(gemini_generation_429_total[5m])",
      "gridPos": { "x": 0, "y": 28, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gemini_generation_429_total[5m]))", "legendFormat": "429/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "orange" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 31, "type": "timeseries", "title": "Other Gemini Failures (non-quota)",
      "description": "rate(gemini_generation_failure_total{error_type!=\"quota\"}[5m])",
      "gridPos": { "x": 6, "y": 28, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(gemini_generation_failure_total{error_type!=\"quota\"}[5m])) by (error_type)", "legendFormat": "{{error_type}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 32, "type": "timeseries", "title": "HTTP 4xx",
      "description": "rate(http_requests_total{status_code=~\"4..\"}[5m])",
      "gridPos": { "x": 12, "y": 28, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[5m]))", "legendFormat": "4xx/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "yellow" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 33, "type": "timeseries", "title": "HTTP 5xx",
      "description": "rate(http_requests_total{status_code=~\"5..\"}[5m])",
      "gridPos": { "x": 18, "y": 28, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "dark-red" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
