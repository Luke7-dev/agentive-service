# Google Gemini API key used for embedding generation (and, later, the AI agent).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides — defaults shown below.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_OUTPUT_DIMENSIONS=768

# Qdrant (run locally via `docker compose up -d`, see docker-compose.yml).
# Optional overrides — defaults shown below.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=car_rental_knowledge
